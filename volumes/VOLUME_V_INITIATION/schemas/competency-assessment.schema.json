{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orynth.net/schemas/morning-star/competency-assessment.schema.json",
  "title": "Morning Star Competency Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "assessment_class",
    "actor_id",
    "competency_id",
    "evaluator_id",
    "evaluator_authority_id",
    "evidence_ids",
    "criterion",
    "result",
    "uncertainty",
    "performed_at",
    "provenance_id",
    "validation_status"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_class": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "competency_id": {
      "type": "string",
      "pattern": "^C(0[1-9]|1[0-5])$"
    },
    "evaluator_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_authority_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "criterion": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": [
        "NOT_EVALUATED",
        "SATISFIED",
        "PARTIALLY_SATISFIED",
        "UNSATISFIED",
        "CONFLICTING",
        "INSUFFICIENT_EVIDENCE",
        "INVALID_EVIDENCE",
        "REASSESSMENT_REQUIRED",
        "NOT_APPLICABLE"
      ]
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance_id": {
      "type": "string",
      "minLength": 1
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "NOT_VALIDATED",
        "VALID",
        "INVALID",
        "UNRESOLVED"
      ]
    }
  }
}
